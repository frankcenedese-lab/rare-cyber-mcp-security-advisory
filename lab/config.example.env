# Copy to lab/.env and fill in values for YOUR lab. Never commit lab/.env.
ENVIRONMENT_NAME=triad-lab
OPERATOR=Frank Cenedese

# Gateway in front of the MCP tool server
MCP_GATEWAY_URL=https://<your-gateway>/mcp
UNREGISTERED_MCP_URL=https://<your-gateway>/unregistered-mcp
# Optional extra header, e.g. APIM subscription key
GATEWAY_EXTRA_HEADER=

# Tool names (must match lab/tools/tool_definitions.json)
READ_TOOL=customer_lookup
WRITE_TOOL=post_journal_entry
EXPORT_TOOL=export_records

# Test identities (short-lived tokens issued for the test run)
READ_ONLY_TOKEN=
READ_WRITE_TOKEN=
EXPIRED_TOKEN=
LIMITED_USER_OBO_TOKEN=

# Identity tests (TC-09 to TC-13)
OTHER_AUDIENCE_TOKEN=
ELEVATED_TOKEN=
AGENT_TOKEN_TO_REVOKE=
OVER_LIMIT_AMOUNT=9999
WITHIN_LIMIT_AMOUNT=50
REVOCATION_TARGET_SECONDS=300

# TC-05 flood size
FLOOD_REQUESTS=60

# TC-02 on Azure: Content Safety (Prompt Shields)
CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
CONTENT_SAFETY_KEY=

# TC-02 on AWS: Bedrock Guardrails
AWS_REGION=ca-central-1
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1
