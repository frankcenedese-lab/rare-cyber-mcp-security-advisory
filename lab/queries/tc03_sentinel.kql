// TC-03: one view of user, agent identity and tool for each test call.
// Reads the "mcp-audit" trace written by the APIM policy in Configuration change C3:
//   oid=<user object ID> upn=<user UPN> agent=<agent app ID (azp)> tool=<tool name>
// Requires APIM diagnostics in resource-specific mode with trace records enabled.
let window = 2h;
ApiManagementGatewayLogs
| where TimeGenerated > ago(window)
| where ApiId has "mcp"
| mv-expand Trace = TraceRecords
| where tostring(Trace.source) == "mcp-audit"
| extend Msg = tostring(Trace.message)
| parse Msg with "oid=" UserObjectId " upn=" UserPrincipalName " agent=" AgentAppId " tool=" Tool
| project TimeGenerated, CorrelationId, ResponseCode, UserObjectId, UserPrincipalName, AgentAppId, Tool
| order by TimeGenerated desc
// Pass: every test call returns one row with the user's object ID, the agent's ID, the tool and the decision.
// Authorization keys on UserObjectId; the UPN is shown for readability only.
